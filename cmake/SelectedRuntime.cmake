# Entered only for -DRUNTIME_CONFIG=<validated advisor JSON>.
if(NOT MSVC)
    message(FATAL_ERROR "Selected runtime currently requires Windows/MSVC")
endif()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${RUNTIME_CONFIG}" "${CMAKE_SOURCE_DIR}/tools/advisor/runtime_plan.py"
    "${CMAKE_SOURCE_DIR}/tools/advisor/advisor.py" "${CMAKE_SOURCE_DIR}/tools/advisor/catalog.py" "${CMAKE_SOURCE_DIR}/tools/advisor/model_asset.py"
    "${CMAKE_SOURCE_DIR}/tools/advisor/ragdoll_asset.py" "${CMAKE_SOURCE_DIR}/tools/advisor/gltf_asset.py" "${CMAKE_SOURCE_DIR}/tools/advisor/fbx_asset.py"
    "${CMAKE_SOURCE_DIR}/tools/model_cooker/main.cpp" "${CMAKE_SOURCE_DIR}/third_party/ufbx/ufbx.c" "${CMAKE_SOURCE_DIR}/third_party/ufbx/ufbx.h")
execute_process(COMMAND "${Python3_EXECUTABLE}" -B
    "${CMAKE_SOURCE_DIR}/tools/advisor/runtime_plan.py" "${RUNTIME_CONFIG}" "${CMAKE_BINARY_DIR}/generated"
    RESULT_VARIABLE _plan_result OUTPUT_VARIABLE _plan_out ERROR_VARIABLE _plan_error)
if(NOT _plan_result EQUAL 0)
    message(FATAL_ERROR "Invalid selected runtime: ${_plan_out}${_plan_error}")
endif()
include("${CMAKE_BINARY_DIR}/generated/features.cmake")
if((RUNTIME_DISTRIBUTION_SIGNATURE AND NOT VERIFY_DISTRIBUTION) OR (VERIFY_DISTRIBUTION AND NOT RUNTIME_DISTRIBUTION_SIGNATURE))
    message(FATAL_ERROR "JSON distribution selection and VERIFY_DISTRIBUTION must agree")
endif()

