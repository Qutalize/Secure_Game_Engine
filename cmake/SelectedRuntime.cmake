endif()
target_link_options(game PRIVATE /OPT:REF /OPT:ICF)
set_target_properties(game PROPERTIES OUTPUT_NAME SelectedGame)
set(_shader_outputs)
if(RUNTIME_RENDER)
    find_program(DXC_EXE dxc)
    if(NOT DXC_EXE)
        file(GLOB _dxc_candidates "C:/Program Files (x86)/Windows Kits/10/bin/*/x64/dxc.exe")
        if(_dxc_candidates)
            list(SORT _dxc_candidates)
            list(GET _dxc_candidates -1 DXC_EXE)
        endif()
    endif()
    if(NOT DXC_EXE)
        message(FATAL_ERROR "Selected rendering requires dxc.exe from Windows SDK")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/shaders")
    foreach(_shader IN LISTS RUNTIME_SHADER_NAMES)
        set(_src "${_shader}.hlsl")
        if(_shader STREQUAL "SimplePS" AND RUNTIME_MATERIAL STREQUAL "unlit")
            set(_src "UnlitPS.hlsl")
        endif()
        if(_shader MATCHES "VS$")
            set(_entry VSMain)
            set(_model vs_6_0)
        else()
            set(_entry PSMain)
            set(_model ps_6_0)
        endif()
        if(RUNTIME_SHADOWS)
            set(_shadow_define 1)
        else()
            set(_shadow_define 0)
        endif()
        if(RUNTIME_RT_HARDWARE AND _model STREQUAL "ps_6_0")
            set(_model ps_6_5)
        endif()
        set(_rt_defines)
        foreach(_rt RAY_TRACING RT_HARDWARE RT_SHADOWS RT_REFLECTIONS RT_MESH)
            if(RUNTIME_${_rt})
                list(APPEND _rt_defines -D ENGINE_${_rt}=1)
            else()
                list(APPEND _rt_defines -D ENGINE_${_rt}=0)
            endif()
        endforeach()
        set(_out "${CMAKE_BINARY_DIR}/shaders/${_shader}.dxil")
        add_custom_command(OUTPUT "${_out}" COMMAND "${DXC_EXE}" -E ${_entry} -T ${_model}
            ${_rt_defines} -D ENGINE_SHADOWS=${_shadow_define} -Qstrip_debug -Qstrip_reflect
            -Fo "${_out}" "${CMAKE_SOURCE_DIR}/assets/shaders/${_src}"
            DEPENDS "${CMAKE_SOURCE_DIR}/assets/shaders/${_src}" "${CMAKE_SOURCE_DIR}/assets/shaders/RayTracing.hlsli" VERBATIM)
        list(APPEND _shader_outputs "${_out}")
    endforeach()
    add_custom_target(selected_shaders DEPENDS ${_shader_outputs})
    add_dependencies(game selected_shaders)
    # Install an explicit list, never a directory with stale shaders from previous selections.
    install(FILES ${_shader_outputs} DESTINATION shaders)
endif()
get_target_property(_source_files selected_engine SOURCES)
get_target_property(_link_libraries selected_engine LINK_LIBRARIES)
get_target_property(_game_sources game SOURCES)
file(WRITE "${CMAKE_BINARY_DIR}/generated/build-inputs.txt" "Sources: ${_source_files}\nGameSources: ${_game_sources}\nLibraries: ${_link_libraries}\nShaders: ${RUNTIME_SHADER_NAMES}\n")
install(TARGETS game RUNTIME DESTINATION .)
install(FILES "${CMAKE_BINARY_DIR}/generated/runtime-plan.json" "${CMAKE_BINARY_DIR}/generated/build-inputs.txt" DESTINATION .)

