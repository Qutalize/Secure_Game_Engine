if(RUNTIME_RIGID_BODY)
    # Pinned vendored CPU-only dependency. No downloads, tools or debug rendering in a player build.
    foreach(_opt GENERATE_DEBUG_SYMBOLS OVERRIDE_CXX_FLAGS USE_STATIC_MSVC_RUNTIME_LIBRARY
            ENABLE_ALL_WARNINGS DEBUG_RENDERER_IN_DEBUG_AND_RELEASE DEBUG_RENDERER_IN_DISTRIBUTION
            PROFILER_IN_DEBUG_AND_RELEASE PROFILER_IN_DISTRIBUTION ENABLE_OBJECT_STREAM ENABLE_INSTALL
            TARGET_UNIT_TESTS TARGET_HELLO_WORLD TARGET_PERFORMANCE_TEST TARGET_SAMPLES TARGET_VIEWER
            USE_SSE4_1 USE_SSE4_2 USE_AVX USE_AVX2 USE_AVX512 USE_LZCNT USE_TZCNT USE_F16C USE_FMADD)
        set(${_opt} OFF CACHE BOOL "Selected Jolt runtime" FORCE)
    endforeach()
    set(INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "Use parent project linking" FORCE)
    set(CPP_EXCEPTIONS_ENABLED ON CACHE BOOL "Match engine exceptions" FORCE)
    set(CPP_RTTI_ENABLED ON CACHE BOOL "Match engine RTTI" FORCE)
    add_subdirectory(third_party/jolt/Build jolt EXCLUDE_FROM_ALL)
    target_sources(selected_engine PRIVATE engine/physics/RigidBodyWorld.cpp)
    target_link_libraries(selected_engine PUBLIC Jolt)
    install(FILES third_party/jolt/LICENSE DESTINATION licenses RENAME Jolt-LICENSE.txt)
    install(FILES third_party/jolt/UPSTREAM.json DESTINATION licenses RENAME Jolt-version.json)
endif()
