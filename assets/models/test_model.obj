# test_model.obj — 検証用の四角錐（ピラミッド）
# このモデルは本プロジェクト用の自作（パブリックドメイン）です。
# 外部素材を使う場合は著作権フリー素材（Kenney/Quaternius 等）または自作のみとすること。
# 底面 1x1（y=0、床に接地）、頂点の高さ 1.5。
mtllib test_model.mtl
usemtl pyramid

# 頂点（底面 4 + 頂点 1）
v -0.5 0.0 -0.5
v  0.5 0.0 -0.5
v  0.5 0.0  0.5
v -0.5 0.0  0.5
v  0.0 1.5  0.0

# 法線（底面 + 側面 4 方向。おおよそ外向き＋上向き）
vn  0.0 -1.0  0.0
vn  0.0  0.45 -0.89
vn  0.89 0.45  0.0
vn  0.0  0.45  0.89
vn -0.89 0.45  0.0

# 底面（-Y）
f 1//1 3//1 2//1
f 1//1 4//1 3//1

# 側面
f 1//2 2//2 5//2
f 2//3 3//3 5//3
f 3//4 4//4 5//4
f 4//5 1//5 5//5
